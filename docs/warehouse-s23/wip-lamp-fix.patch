+// SCRATCH (deleted before the end of the fix round): per-lamp contribution matrix, intensity solve, position search.
+import { writeFileSync } from 'node:fs';
+import type { LightField } from '../src/world/lightField';
+import type { LightRegistry } from '../src/world/lights';
+
+export interface TSpot { name: string; x: number; y: number; z: number; lo: number; hi: number; shut?: boolean }
+export interface Solved { score: number; I: number[]; lines: string[] }
+
+export function solve(reg: LightRegistry, open: LightField, shut: LightField, ids: number[], spots: TSpot[], hiScale = 1.6, m = 0.012): Solved {
+  const fld = (p: TSpot): LightField => (p.shut ? shut : open);
+  const lc = (p: TSpot): number => fld(p).bodyLevel(p.x, p.y + 1.02, p.z, 0);
+  const lh = (p: TSpot): number => fld(p).bodyLevel(p.x, p.y + 1.615, p.z, 0);
+  const lv = (p: TSpot): number => fld(p).bodyLevel(p.x, p.y, p.z, 1.7);
+  const keepI = ids.map((i) => reg.lights[i]!.intensity);
+  const keepOn = ids.map((i) => reg.lights[i]!.on);
+  for (const i of ids) reg.setOn(i, false);
+  const Bc = spots.map(lc);
+  const Bh = spots.map(lh);
+  const T = 0.25;
+  const Cc: number[][] = spots.map(() => ids.map(() => 0));
+  const Ch: number[][] = spots.map(() => ids.map(() => 0));
+  ids.forEach((id, j) => {
+    reg.lights[id]!.intensity = T;
+    reg.setOn(id, true);
+    spots.forEach((p, k) => { Cc[k]![j] = Math.max(0, lc(p) - Bc[k]!) / T; Ch[k]![j] = Math.max(0, lh(p) - Bh[k]!) / T; });
+    reg.setOn(id, false);
+  });
+  ids.forEach((id, j) => { reg.lights[id]!.intensity = keepI[j]!; reg.setOn(id, keepOn[j]!); });
+  const n = ids.length;
+  const I = keepI.map((v) => v);
+  const evc = (v: number[], k: number): number => Bc[k]! + Cc[k]!.reduce((s, c, j) => s + c * v[j]!, 0);
+  const evh = (v: number[], k: number): number => Bh[k]! + Ch[k]!.reduce((s, c, j) => s + c * v[j]!, 0);
+  const ev = (v: number[]): number[] => spots.map((_, k) => Math.min(1, Math.max(evc(v, k), evh(v, k))));
+  for (let it = 0; it < 30000; it++) {
+    const g = new Array<number>(n).fill(0);
+    spots.forEach((p, k) => {
+      const c = evc(I, k);
+      const h = evh(I, k);
+      const L = Math.max(c, h);
+      const C = c >= h ? Cc[k]! : Ch[k]!;
+      const e = L < p.lo + m ? L - (p.lo + m) : L > p.hi - m ? L - (p.hi - m) : 0;
+      if (e !== 0) for (let j = 0; j < n; j++) g[j]! += 2 * e * C[j]!;
+    });
+    for (let j = 0; j < n; j++) I[j] = Math.min(hiScale, Math.max(0, I[j]! - 0.004 * (g[j]! + 0.002 * I[j]!)));
+  }
+  const L = ev(I);
+  const cur = ev(keepI);
+  const act = spots.map(lv);
+  let score = 0;
+  const lines: string[] = [];
+  ids.forEach((id, j) => { const l = reg.lights[id]!; lines.push(`lamp ${j} (${l.x}, ${l.y}, ${l.z}) r${l.radius} I ${keepI[j]!.toFixed(2)} -> ${I[j]!.toFixed(3)}`); });
+  spots.forEach((p, k) => {
+    const v = Math.max(0, p.lo - L[k]!, L[k]! - p.hi);
+    score += v * v;
+    lines.push(`${v > 1e-3 ? 'BAD ' : 'ok  '}${p.name}	base ${Math.max(Bc[k]!, Bh[k]!).toFixed(2)}	pred ${L[k]!.toFixed(2)}	cur ${cur[k]!.toFixed(2)} act ${act[k]!.toFixed(2)}	[${p.lo}-${p.hi}]`);
+  });
+  return { score, I, lines };
+}
+
+export function colWorst(L: Float32Array | number[], lo: number[], hi: number[], stride: number, grid: number): number {
+  const n = L.length / stride;
+  const cols = Math.ceil((hi[0]! - lo[0]!) / grid);
+  const rows = Math.ceil((hi[2]! - lo[2]!) / grid);
+  let worst = 0;
+  for (let r = 0; r < rows; r++) for (let q = 0; q < cols; q++) {
+    const cx0 = lo[0]! + q * grid; const cz0 = lo[2]! + r * grid;
+    let c = 0;
+    for (let i = 0; i < n; i++) {
+      const o = i * stride;
+      const dx = Math.max(cx0 - L[o]!, 0, L[o]! - (cx0 + grid));
+      const dz = Math.max(cz0 - L[o + 2]!, 0, L[o + 2]! - (cz0 + grid));
+      if (Math.sqrt(dx * dx + dz * dz) < L[o + 3]!) c++;
+    }
+    worst = Math.max(worst, c);
+  }
+  return worst;
+}
+
+export interface Ctx {
+  reg: LightRegistry;
+  ids: number[];
+  spots: TSpot[];
+  rebuild: () => { open: LightField; shut: LightField; worst: number };
+  slots: number;
+  file: string;
+}
+
+/** Coordinate descent over (dx, dz, dr) steps of the lamps `vary` (indexes into ids). */
+export function search(ctx: Ctx, vary: number[], rounds: number, step: number): void {
+  const log: string[] = [];
+  const score = (): { s: number; sol: Solved } => {
+    const { open, shut, worst } = ctx.rebuild();
+    const sol = solve(ctx.reg, open, shut, ctx.ids, ctx.spots);
+    return { s: sol.score + (worst > ctx.slots ? 1 + (worst - ctx.slots) : 0), sol };
+  };
+  let best = score();
+  log.push(`start ${best.s.toFixed(5)}`);
+  for (let round = 0; round < rounds; round++) {
+    for (const j of vary) {
+      const l = ctx.reg.lights[ctx.ids[j]!]!;
+      const x0 = l.x; const z0 = l.z; const r0 = l.radius;
+      let bx = x0; let bz = z0; let br = r0;
+      for (const [dx, dz, dr] of [[step, 0, 0], [-step, 0, 0], [0, step, 0], [0, -step, 0], [0, 0, 0.5], [0, 0, -0.5]] as const) {
+        l.x = x0 + dx; l.z = z0 + dz; l.radius = r0 + dr;
+        const r = score();
+        if (r.s < best.s - 1e-6) { best = r; bx = l.x; bz = l.z; br = l.radius; }
+      }
+      l.x = bx; l.z = bz; l.radius = br;
+      log.push(`round ${round} lamp ${j}: (${bx.toFixed(2)}, ${l.y}, ${bz.toFixed(2)}) r${br} score ${best.s.toFixed(5)}`);
+      writeFileSync(ctx.file, log.join('\n'));
+    }
+  }
+  const fin = score();
+  writeFileSync(ctx.file, log.join('\n') + '\n' + fin.sol.lines.join('\n'));
+}
