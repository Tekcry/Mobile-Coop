{
  "_about": "scripts/doc-lint.mjs settings (doc-guard). Current docs = the files every session reads; job docs (docs/<job>/) are per-job records, archived by Job-done. known: stale lines in orchestrator-owned files only (docs/ROADMAP.md, docs/orchestrator/); everything else is an error.",
  "include": [
    "**/*.md"
  ],
  "exclude": [
    "docs/archive/**",
    "CHANGELOG.md",
    "changes/**",
    "node_modules/**",
    "dist/**",
    "public/**"
  ],
  "citations": {
    "scope": [
      "CLAUDE.md",
      "README.md",
      "TESTING.md",
      "docs/*.md",
      "docs/systems/**",
      "docs/templates/**"
    ],
    "skip": [],
    "ownerDocs": [
      "docs/VISION.md",
      "docs/RULES.md",
      "docs/design-bible.md",
      "docs/level-design.md",
      "docs/systems/*.md"
    ],
    "ignore": [
      {
        "file": "docs/systems/ai.md",
        "text": "walk 4.72 G4"
      },
      {
        "file": "docs/systems/coop.md",
        "text": "rig-pose-fix S1, G11 / G12"
      },
      {
        "file": "docs/systems/movement.md",
        "text": "G4, matched to the CT footage"
      }
    ]
  },
  "links": {
    "scope": [
      "CLAUDE.md",
      "README.md",
      "TESTING.md",
      "docs/*.md",
      "docs/systems/**",
      "docs/templates/**"
    ],
    "errorScope": [
      "CLAUDE.md",
      "README.md",
      "TESTING.md",
      "docs/*.md",
      "docs/systems/**",
      "docs/templates/**"
    ],
    "warnScope": [
      "docs/DECISIONS.md"
    ],
    "skip": [],
    "offBranch": [
      "docs/orchestrator/**",
      "docs/missions/**"
    ]
  },
  "owners": {
    "scope": [
      "CLAUDE.md",
      "README.md",
      "TESTING.md",
      "docs/*.md",
      "docs/systems/**",
      "docs/templates/**"
    ],
    "skip": [
      "docs/DECISIONS.md"
    ]
  },
  "sizes": {
    "words": {
      "docs/VISION.md": 900
    },
    "lines": {
      "docs/RULES.md": 312,
      "CLAUDE.md": 60
    },
    "roadmap": "docs/ROADMAP.md",
    "stateResume": {
      "glob": "docs/*/STATE.md",
      "max": 40
    }
  },
  "known": [
    {
      "check": "stale-terms",
      "file": "docs/ROADMAP.md",
      "match": "(claude-md-process-section)",
      "note": "orchestrator: ROADMAP header points at CLAUDE.md \"Sessions\" (fix on feature/menu)"
    },
    {
      "check": "stale-terms",
      "file": "docs/ROADMAP.md",
      "match": "(current-goal-2026-10-19)",
      "note": "orchestrator: ROADMAP \"Goal (CLAUDE.md \\\"Current goal\\\")\" line (fix on feature/menu)"
    }
  ]
}
