+        cam: { alpha: -Math.PI / 2 + (view === 'q' ? 0.2 : 0.05), beta: 1.5, radius: hip ? 4.2 : 3.4, target: V(0.3, hip ? 1.15 : 1.35, 0), sway: 0.01, offsetX: hip ? 0.9 : 0.75 },
+        lights: [key, rim, top],
+        hemi: 0.04,
+      };
+    }
+    default:
+      return null;
+  }
+}
+
+/** `<n>` the solo scene, `<n>a` the solo scene aiming, `c<n>` the co-op variant (two operators). */
+export function buildMenuMock(id: string, scene: Scene): MenuMock | null {
+  const m = /^(c?)([1-7])(a?)$/.exec(id);
+  if (!m) return null;
+  const mk = buildBase(m[2]!, scene);
+  if (!mk) return null;
+  const coop = m[1] === 'c';
+  const aim = m[3] === 'a';
+  const ropeM = mat(scene, '#8a8070');
+  const world = (o: MockOp, l: Local): Vector3 =>
+    V(o.root.x + Math.sin(o.yaw) * l[0] + Math.cos(o.yaw) * l[2], o.root.y + l[1], o.root.z + Math.cos(o.yaw) * l[0] - Math.sin(o.yaw) * l[2]);
+  switch (m[2]) {
+    case '1':
+      if (aim || coop) {
+        // the sidearm from the inverted hang, aimed down past the camera (world aim: the body is tumbled)
+        Object.assign(mk, { weapon: 'pistol', held: true });
+        mk.pose = { ...mk.pose, aim: 1, aimWorldYaw: Math.PI + 0.55, aimWorldPitch: -0.25 };
+        mk.name += ', pistol aimed';
+      }
+      if (coop) {
+        mk.extra = [{ mate: true, weapon: 'rifle', held: true, root: V(-1.3, 0, 0.7), yaw: Math.PI - 0.7, pose: { aim: 1, aimPitch: 0.05, aimYaw: 0.1 } }];
+        mk.cam = { ...mk.cam, radius: mk.cam.radius + 1, target: V(-0.1, 1.9, 0.4) };
+        mk.name = 'co-op: inverted pistol + rifle on the floor';
+      }
+      break;
+    case '2':
+      if (aim || coop) {
+        Object.assign(mk, { weapon: 'pistol', held: true });
+        mk.reachR = undefined;
+        mk.pose = { ...mk.pose, aim: 1, aimPitch: -0.55, aimYaw: 0.15 };
+        mk.name += ', pistol aimed down';
+      }
+      if (coop) {
+        mk.extra = [{ mate: true, weapon: 'rifle', held: true, root: V(-0.55, 0, -0.35), yaw: Math.PI + 0.35, pose: { crouch: 1, aim: 1, aimPitch: 0.02 } }];
+        mk.cam = { ...mk.cam, radius: mk.cam.radius + 0.8, target: V(0, 2.4, 0.2) };
+        mk.name = 'co-op: split overwatch + crouched rifle below';
+      }
+      break;
+    case '3':
+      if (aim) {
+        // the rifle lean-out round the edge
+        Object.assign(mk, { weapon: 'rifle', held: true });
+        mk.pose = { ...mk.pose, lean: -0.75, aim: 1, aimYaw: -0.7, lookYaw: 0 };
+        mk.name += ', rifle lean-out';
+      }
+      if (coop) {
+        Object.assign(mk, { weapon: 'pistol', held: true });
+        mk.pose = { ...mk.pose, lean: -0.75, aim: 1, aimYaw: -0.7, lookYaw: 0 };
+        mk.extra = [{ mate: true, weapon: 'rifle', held: true, root: V(-1.15, 0, 0), yaw: Math.PI, wallAt: -0.155, wallHand: [-0.125, 0.62, -0.3], pose: { wall: true, wallSide: -1, crouch: 1, kneel: true, aim: 0.25, lookYaw: -0.5 } }];
+        mk.cam = { ...mk.cam, radius: mk.cam.radius + 0.6, target: V(-0.4, 1.15, 0) };
+        mk.name = 'co-op: wall stack, pistol lean-out + crouched rifle';
+      }
+      break;
+    case '4':
+      if (aim) {
+        // pistol up at the gap, no hand on the handle
+        Object.assign(mk, { weapon: 'pistol', held: true });
+        mk.reachR = undefined;
+        mk.pose = { ...mk.pose, aim: 1, aimYaw: 0.25, aimPitch: -0.03 };
+        mk.name += ', pistol at the gap';
+      }
+      if (coop) {
+        mk.extra = [{ mate: true, weapon: 'smg', held: true, root: V(0.5, 0, -0.85), yaw: -0.08, pose: { aim: 1, aimPitch: -0.04, crouch: 0.3 } }];
+        mk.cam = { ...mk.cam, radius: mk.cam.radius + 0.5 };
+        mk.name = 'co-op: door stack, peek + SMG covering the gap';
+      }
+      break;
+    case '5':
+      if (aim || coop) {
+        // the brake hand stays on the rope, the sidearm aimed down at the street
+        Object.assign(mk, { weapon: 'pistol', held: true });
+        mk.reachR = undefined;
+        mk.pose = { ...mk.pose, aim: 1, aimYaw: 0.9, aimPitch: -0.6 };
+        mk.name += ', pistol aimed down';
+      }
+      if (coop) {
+        const o: MockOp = { mate: true, root: V(0, 5.3, 1.7), yaw: Math.PI / 2, pose: { traverse: 'rappel', traverseT: 0, lookYaw: -0.4 }, reachL: [-0.1, 0.926, 0.12], reachR: [0.047, 1.315, 0], plantL: [0.48, 0.3, -0.14], plantR: [0.48, 0.48, 0.14] };
+        const up = world(o, o.reachR!);
+        const brake = world(o, o.reachL!);
+        rod(scene, 'rope-m1', V(0.42, 14.3, 1.7), up, 0.022, ropeM);
+        rod(scene, 'rope-m2', up, brake, 0.022, ropeM);
+        rod(scene, 'rope-m3', brake, V(0.3, -2, 1.9), 0.022, ropeM);
+        mk.extra = [o];
+        mk.cam = { ...mk.cam, radius: mk.cam.radius + 1, target: V(0, 6.6, 0.8) };
+        mk.name = 'co-op: twin rappel, one aiming';
+      }
+      break;
+    case '6':
+      if (aim || coop) {
+        Object.assign(mk, { weapon: 'sniper', held: true });
+        mk.pose = { ...mk.pose, aim: 1, aimPitch: -0.12, aimYaw: 0.25, lookYaw: 0 };
+        mk.name += ', sniper over the ledge';
+      }
+      if (coop) {
+        mk.extra = [{ mate: true, root: V(-1.15, 10, 0.55), yaw: Math.PI - 0.3, pose: { crouch: 1, kneel: true, lookYaw: -0.45, lookPitch: -0.1 } }];
+        mk.cam = { ...mk.cam, radius: mk.cam.radius + 0.6, target: V(-0.4, 10.8, 0.3) };
+        mk.name = 'co-op: sniper + spotter';
+      }
+      break;
+  }
+  return mk;
+}
