index 0000000..2f3961e
--- /dev/null
+++ b/src/world/menuMock.ts
@@ -0,0 +1,570 @@
+// THROWAWAY (menu mockups, never commit): `?menuScene=<1-6>` restages the main menu diorama as an Arkham Knight style
+// key-art scene: a hard key light, a big shadow on a wall behind, deep blacks, the tri-lens glow, primitive props.
+import {
+  Color3,
+  Color4,
+  CreateBox,
+  CreateCylinder,
+  CreateDisc,
+  DynamicTexture,
+  type Mesh,
+  Quaternion,
+  type Scene,
+  SpotLight,
+  StandardMaterial,
+  Texture,
+  Vector3,
+  VertexBuffer,
+} from '../core/babylon';
+import type { RigPose } from '../player/characterRig';
+import { Weather } from '../vfx/weather';
+import type { WeaponId } from '../weapons/weaponDefs';
+
+/** Local offset from the root: forward, up, right (the rig's frame). */
+type Local = [number, number, number];
+
+/** One operator in the scene: its pose, place, grips and weapon (held = in the hands, else holstered). */
+export interface MockOp {
+  pose: Partial<RigPose>;
+  root: Vector3;
+  yaw: number;
+  reachL?: Local;
+  reachR?: Local;
+  plantL?: Local;
+  plantR?: Local;
+  wallHand?: Local;
+  wallAt?: number;
+  weapon?: WeaponId;
+  held?: boolean;
+  /** The partner's look (olive suit) instead of the player's. */
+  mate?: boolean;
+}
+
+export interface MenuMock extends MockOp {
+  name: string;
+  /** Co-op partners (posed after the main operator). */
+  extra?: MockOp[];
+  root: Vector3;
+  yaw: number;
+  cam: { alpha: number; beta: number; radius: number; target: Vector3; sway: number; offsetX?: number };
+  /** Shadow casters first (the menu's shadow code takes the first two). */
+  lights: SpotLight[];
+  hemi: number;
+  update?: (dt: number, t: number, camPos: Vector3) => void;
+  dispose?: () => void;
+}
+
+const V = (x: number, y: number, z: number): Vector3 => new Vector3(x, y, z);
+
+function mat(scene: Scene, hex: string, o: { emissive?: number; spec?: number; tex?: Texture } = {}): StandardMaterial {
+  const m = new StandardMaterial(`mock-${hex}-${Math.random().toString(36).slice(2, 6)}`, scene);
+  const c = Color3.FromHexString(hex);
+  m.diffuseColor = c;
+  m.specularColor = new Color3(o.spec ?? 0.04, o.spec ?? 0.04, o.spec ?? 0.04);
+  if (o.emissive) m.emissiveColor = c.scale(o.emissive);
+  if (o.tex) m.diffuseTexture = o.tex;
+  return m;
+}
+
+function box(scene: Scene, name: string, w: number, h: number, d: number, at: Vector3, m: StandardMaterial, rotY = 0): Mesh {
+  const b = CreateBox(name, { width: w, height: h, depth: d }, scene);
+  b.position.copyFrom(at);
+  b.rotation.y = rotY;
+  b.material = m;
+  return b;
+}
+
+function cyl(scene: Scene, name: string, d: number, h: number, at: Vector3, m: StandardMaterial, rot?: Vector3, tess = 16): Mesh {
+  const c = CreateCylinder(name, { diameter: d, height: h, tessellation: tess }, scene);
+  c.position.copyFrom(at);
+  if (rot) c.rotation.copyFrom(rot);
+  c.material = m;
+  return c;
+}
+
+/** A rod from a to b (rope, pipe). */
+function rod(scene: Scene, name: string, a: Vector3, b: Vector3, d: number, m: StandardMaterial): Mesh {
+  const len = Vector3.Distance(a, b);
+  const c = CreateCylinder(name, { diameter: d, height: len, tessellation: 10 }, scene);
+  c.position.copyFrom(a.add(b).scale(0.5));
+  c.rotationQuaternion = new Quaternion();
+  Quaternion.FromUnitVectorsToRef(V(0, 1, 0), b.subtract(a).normalize(), c.rotationQuaternion);
+  c.material = m;
+  return c;
+}
+
+/** A hard spot light (key / rim), optionally a shadow caster's far plane and a projected gobo. */
+function spot(scene: Scene, name: string, pos: Vector3, at: Vector3, angle: number, intensity: number, color: [number, number, number], exp = 2, maxZ = 14): SpotLight {
+  const s = new SpotLight(name, pos, at.subtract(pos).normalize(), angle, exp, scene);
+  s.intensity = intensity;
+  s.diffuse = new Color3(...color);
+  s.specular = new Color3(color[0] * 0.3, color[1] * 0.3, color[2] * 0.3);
+  s.range = 40;
+  s.metadata = { maxZ };
+  return s;
+}
+
+/** A visible beam (additive cone) from a light along its direction. */
+function beam(scene: Scene, name: string, from: Vector3, dir: Vector3, len: number, half: number, color: [number, number, number], glow: number): Mesh {
+  const cone = CreateCylinder(`menuBeam-${name}`, { height: len, diameterTop: 0.1, diameterBottom: 2 * len * Math.tan(half), tessellation: 32, subdivisions: 10, cap: 0 }, scene);
+  const pos = cone.getVerticesData(VertexBuffer.PositionKind)!;
+  const cols = new Float32Array((pos.length / 3) * 4);
+  for (let i = 0; i < pos.length / 3; i++) {
+    const t = (pos[i * 3 + 1]! + len / 2) / len;
+    cols.set([1, 1, 1, Math.pow(t, 2) * (1 - Math.pow(t, 10))], i * 4);
+  }
+  cone.setVerticesData(VertexBuffer.ColorKind, cols);
+  cone.hasVertexAlpha = true;
+  const m = new StandardMaterial(`menuBeam-${name}-mat`, scene);
+  m.disableLighting = true;
+  m.diffuseColor = Color3.Black();
+  m.specularColor = Color3.Black();
+  m.emissiveColor = new Color3(color[0] * glow, color[1] * glow, color[2] * glow);
+  m.alphaMode = 1;
+  m.disableDepthWrite = true;
+  m.backFaceCulling = false;
+  cone.material = m;
+  cone.isPickable = false;
+  cone.receiveShadows = false;
+  const d = dir.normalize();
+  cone.rotationQuaternion = new Quaternion();
+  Quaternion.FromUnitVectorsToRef(V(0, -1, 0), d, cone.rotationQuaternion);
+  cone.position.copyFrom(from).addInPlace(d.scale(len / 2));
+  return cone;
+}
+
+/** A glowing bulb disc facing along dir. */
+function bulb(scene: Scene, name: string, at: Vector3, dir: Vector3, r: number, hex: string): Mesh {
+  const b = CreateDisc(`menuBeam-bulb-${name}`, { radius: r, tessellation: 20 }, scene);
+  b.rotationQuaternion = new Quaternion();
+  Quaternion.FromUnitVectorsToRef(V(0, 0, -1), dir.normalize(), b.rotationQuaternion);
+  b.position.copyFrom(at);
+  const m = new StandardMaterial(`bulb-${name}`, scene);
+  m.disableLighting = true;
+  m.emissiveColor = Color3.FromHexString(hex);
+  b.material = m;
+  return b;
+}
+
+function brickTexture(scene: Scene): DynamicTexture {
+  const t = new DynamicTexture('mockBrick', { width: 512, height: 512 }, scene, true);
+  const c = t.getContext() as unknown as CanvasRenderingContext2D;
+  c.fillStyle = '#2a2624';
+  c.fillRect(0, 0, 512, 512);
+  let seed = 3;
+  const rnd = (): number => ((seed = (seed * 16807) % 2147483647) / 2147483647);
+  const bh = 32;
+  const bw = 96;
+  for (let row = 0; row < 512 / bh; row++) {
+    const off = row % 2 ? bw / 2 : 0;
+    for (let x = -bw; x < 512 + bw; x += bw) {
+      const v = 80 + Math.floor(rnd() * 50);
+      c.fillStyle = `rgb(${v + 30},${v - 5},${v - 22})`;
+      c.fillRect(x + off + 3, row * bh + 3, bw - 6, bh - 6);
+    }
+  }
+  t.update();
+  t.wrapU = t.wrapV = Texture.WRAP_ADDRESSMODE;
+  return t;
+}
+
+/** Window blinds: bright horizontal slats with dark gaps (the spot light's projection). */
+function blindsTexture(scene: Scene): DynamicTexture {
+  const t = new DynamicTexture('mockBlinds', { width: 256, height: 256 }, scene, true);
+  const c = t.getContext() as unknown as CanvasRenderingContext2D;
+  c.fillStyle = '#000';
+  c.fillRect(0, 0, 256, 256);
+  // the window frame (a soft-edged square), slats across it, one mullion down the middle
+  c.fillStyle = '#fff';
+  for (let y = 24; y < 232; y += 18) c.fillRect(24, y, 208, 10);
+  c.fillStyle = '#000';
+  c.fillRect(124, 0, 8, 256);
+  t.update();
+  t.wrapU = t.wrapV = Texture.CLAMP_ADDRESSMODE;
+  return t;
+}
