{
  "name": "mobile-coop",
  "private": true,
  "version": "4.113.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "editor": "vite --port 5199 --open /editor.html",
    "e2e:editor": "node scripts/e2e-editor.mjs",
    "build": "node scripts/prebake.mjs && npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc.tsbuildinfo -p tsconfig.json",
    "preview": "vite preview --host",
    "lint": "eslint . && npm run lint:docs",
    "lint:docs": "node scripts/doc-lint.mjs",
    "test": "vitest run",
    "lamp-audit": "node scripts/lamp-audit.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:legacy": "node scripts/run-e2e.mjs --legacy",
    "e2e:audio": "node scripts/run-e2e.mjs --audio",
    "e2e:gpu": "node scripts/run-e2e.mjs --gpu",
    "e2e:serial": "node scripts/run-e2e.mjs --serial",
    "e2e:quick": "node scripts/run-e2e.mjs --quick",
    "check": "npm run lint && npm test && npm run build",
    "operators:build": "node --import ./scripts/operators/ts-resolve.mjs scripts/operators/build.mjs",
    "operators": "vite build --config vite.operators.config.ts && vite preview --config vite.operators.config.ts",
    "operators:export": "node scripts/operators/export-gltf.mjs",
    "operators:lods": "node scripts/operators/export-gltf.mjs --lods",
    "operators:ktx2": "node scripts/operators/ktx2.mjs",
    "operators:guard-bake": "node scripts/operators/guard-bake.mjs",
    "operators:sheet": "node --import ./scripts/operators/ts-resolve.mjs scripts/operator-sheet.mjs",
    "operators:check": "node --import ./scripts/operators/ts-resolve.mjs scripts/operators/check.mjs",
    "weapons:build": "node scripts/weapons/build.mjs",
    "kit:build": "node scripts/facility-kit/build.mjs",
    "props:build": "node scripts/facility-props/build.mjs",
    "weapons:shots": "node scripts/weapons/shots.mjs",
    "campus-props:build": "node scripts/campus-props/build.mjs",
    "music:fetch": "node scripts/music/fetch-samples.mjs",
    "music:render": "node scripts/music/render.mjs",
    "music:orch": "node scripts/music/render-orch.mjs",
    "sfx:fetch": "node scripts/sfx/fetch-foley.mjs",
    "sfx:render": "node scripts/sfx/render-foley.mjs",
    "sfx:fetch-weapons": "node scripts/sfx/fetch-weapons.mjs",
    "sfx:render-weapons": "node scripts/sfx/render-weapons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "playwright-core": "^1.56.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/ktx2decoder": "^9.29.0",
    "trystero": "^0.26.0"
  }
}
